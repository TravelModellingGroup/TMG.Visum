<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TMG.Visum</RootNamespace>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	  <OutputPath>..\..\XTMF2-Dev\Modules\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TMG-Framework">
      <HintPath>..\..\XTMF2-Dev\Modules\TMG-Framework.dll</HintPath>
    </Reference>
    <Reference Include="XTMF2.Interfaces">
      <HintPath>..\..\XTMF2-Dev\Modules\XTMF2.Interfaces.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assign\" />
    <Folder Include="Calculate\" />
    <Folder Include="Edit\" />
    <Folder Include="Export\" />
    <Folder Include="Import\" />
    <Folder Include="Load\" />
    <Folder Include="Save\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TMG.Visum\TMG.Visum.csproj" />
  </ItemGroup>

</Project>
